{
  "poems": [
    {
      "id": 1,
      "title": "静夜思",
      "author": "唐·李白",
      "content": "床前明月光，疑是地上霜。举头望明月，低头思故乡。",
      "image": "/images/poem_jingyesi.svg"
    },
    {
      "id": 2,
      "title": "春晓",
      "author": "唐·孟浩然",
      "content": "春眠不觉晓，处处闻啼鸟。夜来风雨声，花落知多少。",
      "image": "/images/poem_chunxiao.svg"
    },
    {
      "id": 3,
      "title": "登鹳雀楼",
      "author": "唐·王之涣",
      "content": "白日依山尽，黄河入海流。欲穷千里目，更上一层楼。",
      "image": "/images/poem_dengguanquelou.svg"
    },
    {
      "id": 4,
      "title": "相思",
      "author": "唐·王维",
      "content": "红豆生南国，春来发几枝。愿君多采撷，此物最相思。",
      "image": "/images/poem_xiangsi.svg"
    },
    {
      "id": 5,
      "title": "悯农",
      "author": "唐·李绅",
      "content": "锄禾日当午，汗滴禾下土。谁知盘中餐，粒粒皆辛苦。",
      "image": "/images/poem_minnong.svg"
    },
    {
      "id": 6,
      "title": "江雪",
      "author": "唐·柳宗元",
      "content": "千山鸟飞绝，万径人踪灭。孤舟蓑笠翁，独钓寒江雪。",
      "image": "/images/poem_jiangxue.svg"
    }
  ],
